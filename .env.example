# Copy to .env and fill in your own key. .env is git-ignored and never committed.
#   cp .env.example .env

# Required: the agent team runs on this. Without it the backend falls back to a
# deterministic path that still calls every MCP tool, so the app stays usable.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6-luna

# Optional: only needed if you route through Portkey instead.
PORTKEY_API_KEY=your_portkey_api_key_here
PORTKEY_MODEL=gpt-6-luna
